{
  "expo": {
    "name": "AZAP Online",
    "slug": "azap-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "azap",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06060e",
    "ios": {
      "bundleIdentifier": "online.azap.app",
      "appleTeamId": "CNANRXP44Q",
      "supportsTablet": false,
      "buildNumber": "14",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "AZAP, profil fotoğrafı çekmek ve şikâyet bildirimine görüntü eklemek için kameranıza erişir.",
        "NSPhotoLibraryUsageDescription": "AZAP, profil fotoğrafı ve şikâyet görüntüsü seçebilmeniz için fotoğraflarınıza erişir.",
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "package": "online.azap.app",
      "adaptiveIcon": {
        "backgroundColor": "#06060e",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "plugins": [
      "expo-iap",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06060e",
          "image": "./assets/icon.png",
          "imageWidth": 160
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "98e2151f-3589-4b51-9316-35ca1e8d682b"
      }
    },
    "owner": "akdag994"
  }
}
