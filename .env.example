# AZAP Çevre Değişkenleri (.env dosyasına kopyala, sırlarını doldur, ASLA git'e ekleme!)

# Sunucu portu (varsayılan 3000)
PORT=3000

# Production modu (development'ta dev-complete endpoint'i çalışır, production'da kapalı)
# Değerler: development | production
NODE_ENV=production

# CORS izinli origin (production'da kendi domain'in olmalı)
# Örnek: https://azap.online
CORS_ORIGIN=*

# ── İYZİCO ÖDEME (production için zorunlu) ──
# https://merchant.iyzipay.com adresinden API key + Secret key al
# IYZICO_API_KEY tanımlanmamışsa: sistem dev modunda çalışır (gerçek ödeme alınmaz)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URI=https://api.iyzipay.com
# Sandbox (test) için: https://sandbox-api.iyzipay.com

# ── ADMIN ──
# İlk admin kullanıcı (manuel data/users.json içinde isAdmin:true olarak işaretlenmeli)
# Veya: node make-admin.js <username> komutu ile yapılır
